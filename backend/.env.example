# Freshdesk trial tenant (Profile settings > API key)
FRESHDESK_DOMAIN=your-subdomain
FRESHDESK_API_KEY=your-freshdesk-api-key

# Claude API key used for AI grading and coaching drafts
ANTHROPIC_API_KEY=your-anthropic-api-key

# "claude" (default) or "mock" (offline heuristic grader for local UI testing only, no API calls)
GRADER=claude
# Grading effort for Claude Sonnet 5: low | medium | high
GRADER_EFFORT=low

# Shared secret the FDK app sends in the X-QA-Secret header. Leave empty to disable auth in local dev.
QA_API_SECRET=

# Review-queue routing
QUEUE_SCORE_THRESHOLD=70
QUEUE_RANDOM_SAMPLE_PCT=5

PORT=4000
# SQLite file (relative to backend/)
DB_PATH=data/native-qa.db
